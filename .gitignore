.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store

# Every .env variant is a secret except the committed template. Bare `.env`
# alone left .env.local, .env.production and .env.bak committable, which is
# exactly the shape of an accidental key leak.
.env*
!.env.example

# Model + tokenizer caches
.cache/
tiktoken_cache/

# Generated evaluation output (regenerate with `python -m eval.harness`)
reports/*.json
reports/*.csv
!reports/.gitkeep
# ...except the shipped benchmark. /evaluate serves this to populate the hero
# metrics instantly; without it in the image the deployed dashboard has no
# accuracy, cost or latency numbers at all.
!reports/latest.json
!reports/latest.csv
